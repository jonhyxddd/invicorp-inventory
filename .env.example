# =============================================================================
# INVICORP INVENTORY - Variables de entorno
# =============================================================================
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env con secretos reales al control de versiones.

# URL de tu proyecto Supabase (ej: https://tu-proyecto.supabase.co)
VITE_SUPABASE_URL=

# Clave pública (anon key) de Supabase - solo para frontend
VITE_SUPABASE_ANON_KEY=

# =============================================================================
# Configuración opcional
# =============================================================================

# Tiempo de bloqueo automático en minutos (por defecto 30)
VITE_AUTO_LOCK_MINUTES=30

# Umbral de stock bajo como porcentaje (por defecto 100 = stock <= min_stock)
VITE_LOW_STOCK_THRESHOLD=100

# =============================================================================
# IMPORTANTE - Seguridad
# =============================================================================
# - Nunca expongas la service_role key en el frontend.
# - La service_role key solo se usa en Edge Functions o servidor backend.
# - El PIN se deriva en el cliente con PBKDF2 y el hash se envía a Supabase.
# - Usa RLS (Row Level Security) en Supabase para aislar datos por negocio.
# =============================================================================
